From b744a66fcc814843cec8d4696d1dca9d5f6a32e2 Mon Sep 17 00:00:00 2001
From: aartoni <alessio@artoni.org>
Date: Fri, 9 Oct 2026 22:35:53 +0200
Subject: [PATCH] minilarbs-full-sleep

---
 dwmblocks.c | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/dwmblocks.c b/dwmblocks.c
index 0ebbd60..c30e407 100644
--- a/dwmblocks.c
+++ b/dwmblocks.c
@@ -3,6 +3,7 @@
 #include<string.h>
 #include<unistd.h>
 #include<signal.h>
+#include<time.h>
 #include<sys/wait.h>
 #ifndef NO_X
 #include<X11/Xlib.h>
@@ -173,7 +174,9 @@ void statusloop()
 		writestatus();
 		if (!statusContinue)
 			break;
-		sleep(1.0);
+		struct timespec ts = { .tv_sec = 1 };
+		while (nanosleep(&ts, &ts) == -1 && statusContinue)
+			;
 	}
 }
 
